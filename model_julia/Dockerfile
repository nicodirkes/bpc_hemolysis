# Auto-generated by .github/scripts/update-julia.sh (Julia version from
# Project.toml [compat]); pinned by the committed Manifest.toml. Do not edit.
FROM julia:1.11

ENV JULIA_PROJECT=/opt/model_julia
ENV JULIA_DEPOT_PATH=/usr/local/share/.julia
ENV JULIA_HISTORY=/tmp/logs/repl_history.jl

# procps: `ps` is needed by Nextflow reports
RUN apt-get update \
    && apt-get install -y procps \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/model_julia /usr/local/share/.julia /tmp/logs \
    && chmod 0755 /opt/model_julia /usr/local/share/.julia /tmp/logs

COPY Project.toml Manifest.toml /opt/model_julia/
# Precompile for a portable CPU target. The default is the build machine's own CPU,
# which other CPUs reject, so Julia re-precompiles at every container start.
RUN case "$(uname -m)" in \
      x86_64) export JULIA_CPU_TARGET="generic;sandybridge,-xsaveopt,clone_all;haswell,-rdrnd,base(1)" ;; \
    esac \
    && julia -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'
